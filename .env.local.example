# Salin menjadi .env.local. Jangan commit rahasia atau database.
APP_PORT=3000
# Path absolut. Folder dibuat bila belum ada.
WORKSPACE_DIR=
# Diambil dari akun ElevenLabs. Key dibaca server saja.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Default jika belum dipilih dari Pengaturan. Gunakan model yang mendukung audio tags.
ELEVENLABS_MODEL_ID=eleven_v3

# Opsional: statistik channel untuk Riset topik (hanya izin baca).
# Aktifkan YouTube Data API v3 + YouTube Analytics API. OAuth client: Web application.
# Redirect: http://127.0.0.1:3000/integrations/youtube/callback
# Tambahkan URI localhost juga bila membuka aplikasi via localhost.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
